# Frontend (Vercel)
# Public URL of the persistent Socket.IO backend (e.g., https://your-socket-server.onrender.com or https://your-socket-server.up.railway.app)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# Optional: Public URL of the Next.js frontend (used when generating QR codes; defaults to window.location.origin)
NEXT_PUBLIC_APP_URL=

# Backend Server (Railway / Render)
# PORT=4001
# ALLOWED_ORIGINS=https://your-presentation.vercel.app,http://localhost:3000
# SESSION_TTL_MS=7200000
